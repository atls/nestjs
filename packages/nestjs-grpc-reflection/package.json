{
  "name": "@atls/nestjs-grpc-reflection",
  "version": "1.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./proto": {
      "import": "./proto/index.cjs",
      "require": "./proto/index.cjs",
      "types": "./proto/index.d.ts"
    }
  },
  "main": "src/index.ts",
  "files": [
    "proto",
    "dist"
  ],
  "scripts": {
    "build": "yarn library build",
    "prepack": "yarn run build",
    "postpack": "rm -rf dist",
    "proto:generate": "PATH=$PATH:$(yarn bin ts-proto) buf generate",
    "proto:lint": "buf lint"
  },
  "dependencies": {
    "@atls/nestjs-proto-types": "workspace:*",
    "@bufbuild/protobuf": "2.2.3",
    "@grpc/grpc-js": "1.12.5",
    "@grpc/proto-loader": "0.7.13",
    "google-protobuf": "3.21.4",
    "long": "5.2.3",
    "protobufjs": "7.4.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@types/google-protobuf": "3.15.12",
    "@types/long": "5.0.0",
    "@types/node": "24.19.1",
    "get-port": "7.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "supertest": "6.3.4",
    "ts-proto": "2.6.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "@nestjs/microservices": "^10 || ^11",
    "reflect-metadata": "0.2",
    "rxjs": "7"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./proto": {
        "import": "./proto/index.cjs",
        "require": "./proto/index.cjs",
        "types": "./proto/index.d.ts"
      }
    },
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  },
  "typecheckSkipLibCheck": true
}
