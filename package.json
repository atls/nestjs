{
  "name": "nestjs",
  "private": true,
  "license": "BSD-3 Clause",
  "type": "module",
  "workspaces": [
    "packages/**/*",
    "examples/**/*"
  ],
  "lint-staged": {
    "*.{yml,yaml,json,graphql,md}": "yarn format",
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "yarn format",
      "yarn lint"
    ],
    "*.{test,spec}.{ts,tsx}": "yarn test unit"
  },
  "devDependencies": {
    "@atls/raijin": "latest",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.18.0",
  "typecheckSkipLibCheck": true
}
