{
  "name": "nestjs",
  "private": true,
  "license": "BSD-3 Clause",
  "type": "module",
  "workspaces": [
    "packages/**/*",
    "examples/**/*"
  ],
  "lint-staged": {
    "*.{yml,yaml,json,graphql,md}": "yarn format",
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "yarn format",
      "yarn lint"
    ],
    "*.{test,spec}.{ts,tsx}": "yarn test unit"
  },
  "devDependencies": {
    "@atls/raijin": "1.1.1",
    "@types/node": "22.20.0",
    "typescript": "5.5.4"
  },
  "packageManager": "yarn@4.18.0",
  "formatterIgnorePatterns": [
    "**/*/CHANGELOG.md"
  ],
  "typecheckSkipLibCheck": true
}
